[Unit]
Description=Daybreak Island game server
After=network.target

[Service]
User=daybreak
WorkingDirectory=/opt/daybreak-island
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=5180
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=2
MemoryMax=300M
CPUQuota=60%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
